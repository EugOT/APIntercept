# Interceptor — Development Environment
# See README.md for setup instructions

# Runtime
NODE_ENV=development

# API / browser control-plane hardening
# In development, no token is required unless this value is set.
# In production, INTERCEPTOR_CONTROL_TOKEN is mandatory.
INTERCEPTOR_CONTROL_TOKEN=
INTERCEPTOR_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
INTERCEPTOR_API_URL=http://localhost:3001
NEXT_PUBLIC_INTERCEPTOR_WS_URL=ws://localhost:3001

# Keep request bodies out of the traffic buffer by default.
INTERCEPTOR_CAPTURE_REQUEST_BODIES=false
INTERCEPTOR_TRAFFIC_TTL_MS=900000
INTERCEPTOR_TRAFFIC_MAX_ENTRIES=200
INTERCEPTOR_MAX_HTTP_BODY_BYTES=1048576
INTERCEPTOR_WS_MAX_PAYLOAD_BYTES=65536
INTERCEPTOR_WS_MESSAGES_PER_MINUTE=120

# Leave empty to use `pixi run python` locally, or set an explicit runtime path.
INTERCEPTOR_PYTHON=
