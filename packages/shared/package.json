{
	"name": "@interceptor/shared",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./dist/types.js"
		},
		"./python-bridge": {
			"types": "./src/python-bridge/index.ts",
			"default": "./dist/python-bridge/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"typescript": "5.9.3"
	}
}
