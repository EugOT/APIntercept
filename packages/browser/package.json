{
	"name": "@interceptor/browser",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./remote": {
			"types": "./src/remote/index.ts",
			"default": "./dist/remote/index.js"
		},
		"./remote/profiles": {
			"types": "./src/remote/profiles.ts",
			"default": "./dist/remote/profiles.js"
		},
		"./shared": {
			"types": "./src/shared/index.ts",
			"default": "./dist/shared/index.js"
		},
		"./shared/config": {
			"types": "./src/shared/config.ts",
			"default": "./dist/shared/config.js"
		},
		"./shared/types": {
			"types": "./src/shared/types.ts",
			"default": "./dist/shared/types.js"
		},
		"./shared/auth": {
			"types": "./src/shared/auth.ts",
			"default": "./dist/shared/auth.js"
		},
		"./shared/interceptor": {
			"types": "./src/shared/interceptor.ts",
			"default": "./dist/shared/interceptor.js"
		},
		"./shared/session-manager": {
			"types": "./src/shared/session-manager.ts",
			"default": "./dist/shared/session-manager.js"
		},
		"./handler": {
			"types": "./src/handler/index.ts",
			"default": "./dist/handler/index.js"
		},
		"./handler/api-proxy": {
			"types": "./src/handler/api-proxy.ts",
			"default": "./dist/handler/api-proxy.js"
		},
		"./handler/domain-loader": {
			"types": "./src/handler/domain-loader.ts",
			"default": "./dist/handler/domain-loader.js"
		},
		"./analysis": {
			"types": "./src/analysis/discovery-analyzer.ts",
			"default": "./dist/analysis/discovery-analyzer.js"
		},
		"./analysis/discovery": {
			"types": "./src/analysis/discovery-analyzer.ts",
			"default": "./dist/analysis/discovery-analyzer.js"
		},
		"./analysis/dom": {
			"types": "./src/analysis/dom-orchestrator.ts",
			"default": "./dist/analysis/dom-orchestrator.js"
		},
		"./codegen": {
			"types": "./src/codegen/index.ts",
			"default": "./dist/codegen/index.js"
		},
		"./registry": {
			"types": "./src/registry.ts",
			"default": "./dist/registry.js"
		},
		"./mcp": {
			"types": "./src/mcp/server.ts",
			"default": "./dist/mcp/server.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"codegen": "tsx src/codegen/cli.ts",
		"browser:install": "patchright install chromium"
	},
	"dependencies": {
		"@ghostery/adblocker-playwright": "2.14.1",
		"@modelcontextprotocol/sdk": "1.27.1",
		"cheerio": "^1.2.0",
		"cross-fetch": "4.1.0",
		"hono": "^4.12.8",
		"patchright": "1.58.2",
		"ws": "8.18.2",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3",
		"vitest": "4.1.0"
	},
	"overrides": {
		"@ghostery/adblocker-playwright": {
			"playwright": "npm:patchright@1.57.0"
		}
	}
}
