# ==============================================================================
# PRODUCTION ENVIRONMENT — BrowserAgent
# ==============================================================================
# Copy to .env and fill in real values before deploying.

# Runtime
NODE_ENV=production
HOST=0.0.0.0

# Control-plane auth. Generate with: openssl rand -base64 32
INTERCEPTOR_CONTROL_TOKEN=CHANGE_ME
INTERCEPTOR_ALLOWED_ORIGINS=https://example.dev,https://www.example.dev
INTERCEPTOR_API_URL=http://api:3001

# Capture hygiene
INTERCEPTOR_CAPTURE_REQUEST_BODIES=false
INTERCEPTOR_TRAFFIC_TTL_MS=900000
INTERCEPTOR_TRAFFIC_MAX_ENTRIES=200
INTERCEPTOR_TRAFFIC_MAX_BODY_BYTES=50000
INTERCEPTOR_TRAFFIC_BODY_PREVIEW_BYTES=2000

# Request and WebSocket bounds
INTERCEPTOR_MAX_HTTP_BODY_BYTES=1048576
INTERCEPTOR_WS_MAX_PAYLOAD_BYTES=65536
INTERCEPTOR_WS_MESSAGES_PER_MINUTE=120
INTERCEPTOR_WS_MAX_TEXT_LENGTH=4096

# Docker runtime path. Local development should prefer pixi-managed Python.
INTERCEPTOR_PYTHON=/usr/bin/python3
